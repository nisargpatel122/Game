+  Game.prototype.updateDiverter = function () {
+    const d = this.diverter;
+    const live = this.state === 'playing' || this.state === 'attract';
+    const up = live && ((!!this.shooterBall() && !this.buttons.L) || this.time < this.launchUntil);
